{
  "manifest_version": 3,
  "name": "CyberWatch – Threat Detection",
  "version": "1.0.0",
  "description": "Unified Web & Browser Threat Detection Platform scanner for URLs, websites, APIs, phishing, files, and extensions.",
  "icons": {
    "16": "assets/icon16.png",
    "32": "assets/icon32.png",
    "48": "assets/icon48.png",
    "128": "assets/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "CyberWatch Security Scanner",
    "default_icon": {
      "16": "assets/icon16.png",
      "32": "assets/icon32.png",
      "48": "assets/icon48.png",
      "128": "assets/icon128.png"
    }
  },
  "background": {
    "service_worker": "dist/background.js",
    "type": "module"
  },
  "permissions": [
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "http://localhost:5000/*",
    "http://127.0.0.1:5000/*",
    "http://localhost:5173/*",
    "http://127.0.0.1:5173/*"
  ]
}